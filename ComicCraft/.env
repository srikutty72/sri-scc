APP_NAME=ComicCraft AI
APP_VERSION=1.0.0

# ==========================================
# Gemini API
# ==========================================

GEMINI_API_KEY=

# Current supported Gemini model
GEMINI_FLASH_MODEL=gemini-3.1-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview
GEMINI_PRO_MODEL=gemini-3.1-pro-preview


# ==========================================
# Hugging Face API
# ==========================================

HF_API_KEY=

# Image generation model
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0


# ==========================================
# Development mode
# ==========================================

DEMO_MODE=true

# ==========================================
# Server
# ==========================================

HOST=127.0.0.1
PORT=8000
DEBUG=true


# ==========================================
# Comic settings
# ==========================================

DEFAULT_PANELS=5
MIN_PANELS=1
MAX_PANELS=12


# ==========================================
# Image settings
# ==========================================

IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024


# ==========================================
# API timeout
# ==========================================

API_TIMEOUT=180
